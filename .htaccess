# Energe - Reverted .htaccess
RewriteEngine On
RewriteBase /

# 1. Force HTTPS (Highly recommended)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Redirect index.html to root
RewriteCond %{THE_REQUEST} ^GET\ /index\.html\ HTTP [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 3. Handle 404 (Keep the custom one)
ErrorDocument 404 /404.html

# 4. (Optional) Redirect clean URLs to .html if someone tries them
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [R=301,L]


# Blog Migration Redirects
RedirectMatch 301 ^/blog-(.*)\.html$ /blog/$1.html
RedirectMatch 301 ^/en/blog-(.*)\.html$ /en/blog/$1.html

# Deleted Blog Redirections
Redirect 301 /blog/mendovoz-2020-climatizadores-solares.html /blog.html
Redirect 301 /en/blog/mendovoz-2020-solar-heaters.html /en/blog.html
