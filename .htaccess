# Redirects 301 for SEO
RewriteEngine On
RewriteBase /

# 1. Force HTTPS and www (Highly recommended for SEO)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Remove index.html from URL
RewriteCond %{THE_REQUEST} ^GET\ /index\.html\ HTTP [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 3. Remove .html extension from URL (External Redirect)
RewriteCond %{THE_REQUEST} ^GET\ (.*)\.html\ HTTP [NC]
RewriteRule ^(.*)\.html$ /$1 [R=301,L]

# 4. Internally map clean URL to .html file (Internal Rewrite)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 5. Redirect common 404 patterns to new pages
Redirect 301 /noticias/ /blog
Redirect 301 /empresa/ /#contacto
Redirect 301 /paneles-solares/ /soluciones-ongrid
Redirect 301 /contacto/ /#contacto
Redirect 301 /productos/ /#soluciones

# 6. Custom 404 page
ErrorDocument 404 /404.html
